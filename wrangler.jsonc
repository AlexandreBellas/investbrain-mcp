/**
 * Cloudflare Workers config for the Investbrain MCP server.
 * Free plan: Workers plus one SQLite Durable Object for auth lockouts.
 * No paid bindings (no Workers Rate Limiting, AI, or queues).
 *
 * INVESTBRAIN_BASE_URL is intentionally empty in git. The deploy workflow
 * replaces the placeholder `"INVESTBRAIN_BASE_URL": ""` from the
 * INVESTBRAIN_BASE_URL GitHub secret. Local dev overrides it with .dev.vars.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "investbrain-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-29",
	"compatibility_flags": ["nodejs_compat"],
	"migrations": [
		{
			"new_sqlite_classes": ["AuthRateLimit"],
			"tag": "v1",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "AuthRateLimit",
				"name": "AUTH_RATE_LIMIT",
			},
		],
	},
	"vars": {
		"AUTH_FAILURE_LIMIT": "10",
		"AUTH_FAILURE_WINDOW_SECONDS": "900",
		"AUTH_LOCKOUT_SECONDS": "1800",
		"INVESTBRAIN_BASE_URL": "",
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01,
		},
	},
	"upload_source_maps": true,
}
